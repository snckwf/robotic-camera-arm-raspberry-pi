[Unit]
Description=Controller remoto del braccio telecamera (Arduino Nano via USB)
After=network-online.target braccio-web.service
Wants=braccio-web.service

[Service]
ExecStart=/usr/bin/python3 /opt/braccio/controller_braccio.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
